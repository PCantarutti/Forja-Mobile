{
  "expo": {
    "name": "Forja",
    "slug": "forja-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#171717",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.forja.mobile",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Ler o QR de pareamento do Forja Desktop",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Salvar na galeria as imagens geradas no Forja",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "backgroundColor": "#171717",
    "extra": {
      "eas": {
        "projectId": "935a7b22-0ce3-4e9a-a670-ccd02e361ea2"
      }
    },
    "owner": "cantarutti",
    "scheme": "forja"
  }
}
