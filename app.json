{
  "expo": {
    "name": "Forja",
    "slug": "forja-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#171717",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.forja.mobile",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Ler o QR de pareamento do Forja Desktop",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8a8a8a"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Salvar na galeria as imagens geradas no Forja",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#171717",
          "image": "./assets/splash-vazio.png",
          "imageWidth": 1
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Atkinson",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/AtkinsonHyperlegibleNext_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/AtkinsonHyperlegibleNext_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "JetBrains Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMono_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/JetBrainsMono_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "IBM Plex Sans",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/IBMPlexSans_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/IBMPlexSans_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "IBM Plex Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/IBMPlexMono_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/IBMPlexMono_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "backgroundColor": "#171717",
    "extra": {
      "eas": {
        "projectId": "935a7b22-0ce3-4e9a-a670-ccd02e361ea2"
      }
    },
    "owner": "cantarutti",
    "scheme": "forja"
  }
}
